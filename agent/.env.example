# DITTO_LLM_MODE=mock uses fixed responses (schema-conformant) — no API key needed.
# DITTO_LLM_MODE=live calls OpenAI.
DITTO_LLM_MODE=mock

OPENAI_API_KEY=
DITTO_OPENAI_MODEL=gpt-5

# Where the LangGraph checkpointer's SQLite file lives (thread/interrupt state only —
# not domain data, that's the FastAPI teammate's DB).
DITTO_CHECKPOINT_DB=./ditto_checkpoints.db
